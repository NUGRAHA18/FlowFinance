# ─── Supabase Postgres ────────────────────────────────────────────────────────
# Ambil dari Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL = "Transaction pooler" (port 6543). Dipakai aplikasi saat runtime.
#                Wajib pakai ?pgbouncer=true agar Prisma mematikan prepared statement.
# DIRECT_URL   = "Direct connection" (port 5432). Dipakai `prisma migrate` saja.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Ukuran connection pool aplikasi. Naikkan hati-hati — Supabase free tier terbatas.
DB_POOL_MAX=10

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Minimal 32 karakter. Generate: openssl rand -hex 32
JWT_SECRET="ganti_dengan_secret_acak_minimal_32_karakter"

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# Render mengisi PORT sendiri. Untuk lokal biarkan 5000.
PORT=5000

# Origin frontend yang diizinkan CORS. Boleh lebih dari satu, dipisah koma.
# Domain *.vercel.app (preview deployment) otomatis diizinkan.
FRONTEND_URL="http://localhost:5173"
