# Base URL REST API backend — HARUS termasuk sufiks /api
#
# Lokal   : http://localhost:5000/api
# Produksi: https://flowfinance-api.onrender.com/api
#
# Catatan: variabel Vite di-inline saat build, bukan dibaca saat runtime.
# Setelah mengubah nilai ini di Vercel, wajib redeploy agar berlaku.
VITE_API_URL="http://localhost:5000/api"
